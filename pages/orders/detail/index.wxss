.tag.gray {
  background: var(--field);
  color: var(--muted);
}

.amount {
  margin-top: 20rpx;
  color: var(--reward);
  font-size: 56rpx;
  font-weight: 850;
  line-height: 1.2;
}

.amount-yuan {
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 4rpx;
}

.confirm-rows {
  margin-top: 24rpx;
  background: var(--field);
  border-radius: var(--radius-field);
  padding: 8rpx 24rpx;
}

.confirm-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
}

.confirm-row + .confirm-row {
  border-top: 1rpx solid var(--line);
}

.confirm-role {
  color: var(--muted);
  font-size: 26rpx;
}

.confirm-state {
  color: var(--amber);
  font-size: 26rpx;
  font-weight: 700;
}

.confirm-state.ok {
  color: var(--green);
}

.timeline {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--line);
}

.tl-item {
  display: flex;
  align-items: center;
  min-height: 56rpx;
}

.tl-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--brand);
  margin-right: 18rpx;
  flex-shrink: 0;
}

.tl-label {
  color: var(--ink);
  font-size: 26rpx;
}

.tl-time {
  margin-left: auto;
  color: var(--faint);
  font-size: 24rpx;
}

.auto-hint {
  margin-top: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: var(--radius-field);
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 24rpx;
  line-height: 1.5;
}

.actions {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.actions .btn {
  flex: 1;
}

.section-title {
  font-size: 30rpx;
  font-weight: 800;
}

.history-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 0;
}

.history-item + .history-item {
  border-top: 1rpx solid var(--line);
}

.section-title + .history-item {
  margin-top: 8rpx;
}

.current-pill {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  background: var(--brand-soft);
  color: var(--brand);
  font-size: 20rpx;
  font-weight: 700;
}

.history-amount {
  color: var(--reward);
  font-size: 28rpx;
  font-weight: 800;
}

.history-time {
  margin-left: auto;
  color: var(--faint);
  font-size: 24rpx;
}
