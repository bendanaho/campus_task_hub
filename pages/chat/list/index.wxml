<view class="page">
  <view class="chat-header">
    <view class="chat-title">聊天</view>
    <view class="chat-tools">
      <view class="tool-btn" hover-class="btn-hover" bindtap="clearUnread" aria-role="button" aria-label="清除未读">🧹</view>
      <view class="tool-btn" hover-class="btn-hover" bindtap="goSettings" aria-role="button" aria-label="消息设置">⚙️</view>
    </view>
  </view>

  <view wx:if="{{!loggedIn}}" class="card guest">
    <view class="guest-title">登录后查看消息</view>
    <button class="btn guest-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="search-box">
      <view class="search-icon"></view>
      <input class="search-input" placeholder="搜索联系人、任务或消息" value="{{keyword}}" bindinput="onSearchInput" />
    </view>

    <view class="conversation card section sys-entry" bindtap="openSystem" hover-class="card-hover">
      <view class="avatar sys-avatar">🔔</view>
      <view class="main">
        <view class="space-between">
          <text class="name">系统通知</text>
          <text wx:if="{{sysConv}}" class="muted time">{{sysConv.lastTimeText}}</text>
        </view>
        <view class="last">{{sysConv.lastMessage || '订单动态和平台通知会显示在这里'}}</view>
      </view>
      <view wx:if="{{sysConv.unreadCount > 0}}" class="badge">{{sysConv.unreadCount}}</view>
    </view>

    <view wx:if="{{loading && conversations.length == 0}}" class="empty">正在加载会话...</view>
    <empty-state
      wx:elif="{{conversations.length == 0 && !keyword}}"
      emoji="💬"
      title="暂无会话"
      sub="去大厅找任务，联系发布者"
      btn-text="去大厅"
      bind:action="goHall"
    />
    <view wx:elif="{{conversations.length == 0 && keyword}}" class="empty">没有匹配「{{keyword}}」的会话</view>

    <view wx:for="{{conversations}}" wx:key="id" class="swipe-item section">
      <view class="swipe-del" data-id="{{item.id}}" catchtap="deleteConv">删除</view>
      <view
        class="conversation card swipe-content {{swipeId === item.id ? 'open' : ''}}"
        data-id="{{item.id}}"
        bindtap="openRoom"
        bindtouchstart="onConvTouchStart"
        bindtouchend="onConvTouchEnd"
        hover-class="card-hover"
      >
        <view class="avatar">{{item.avatarText}}</view>
        <view class="main">
          <view class="space-between">
            <text class="name">{{item.partnerName}}</text>
            <text class="muted time">{{item.lastTimeText}}</text>
          </view>
          <view class="task">{{item.taskTitle || '普通会话'}}</view>
          <view class="last">{{item.lastMessage || '还没有消息'}}</view>
        </view>
        <view wx:if="{{item.unreadCount > 0}}" class="badge">{{item.unreadCount}}</view>
      </view>
    </view>
  </block>
</view>
