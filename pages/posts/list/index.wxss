.hall {
  min-height: 100vh;
}

/* 头部：吸顶；上滑后标题/副标题收起，只留搜索框 */
.hall-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: linear-gradient(155deg, #7EA6FF 0%, #5B8CFF 45%, #3B6FE0 100%);
  padding-left: 28rpx;
  padding-right: 28rpx;
  padding-bottom: 26rpx;
  border-radius: 0 0 32rpx 32rpx;
}

.hall-nav {
  height: 88rpx;
}

.hall-title {
  font-size: 44rpx;
  line-height: 60rpx;
  max-height: 60rpx;
  font-weight: 800;
  color: #ffffff;
  letter-spacing: 1rpx;
  overflow: hidden;
  opacity: 1;
  transition: max-height 0.25s ease, opacity 0.2s ease, margin 0.25s ease;
}

.hall-subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 34rpx;
  max-height: 34rpx;
  color: rgba(255, 255, 255, 0.78);
  overflow: hidden;
  opacity: 1;
  transition: max-height 0.25s ease, opacity 0.2s ease, margin 0.25s ease;
}

.hall-header.collapsed .hall-title,
.hall-header.collapsed .hall-subtitle {
  max-height: 0;
  opacity: 0;
  margin-top: 0;
}

/* 头部渐变跟随外观设置的背景色换色系（白字可读性均已校准） */
.theme-light.bg-b2 .hall-header {
  background: linear-gradient(155deg, #EFB769 0%, #E39A45 45%, #CE7F2E 100%);
}

.theme-light.bg-b3 .hall-header {
  background: linear-gradient(155deg, #6FCBA0 0%, #3EB27F 45%, #22946A 100%);
}

.theme-light.bg-b4 .hall-header {
  background: linear-gradient(155deg, #6FB6FF 0%, #4396F2 45%, #2E78D9 100%);
}

.theme-light.bg-b5 .hall-header {
  background: linear-gradient(155deg, #F49BBB 0%, #EC7AA4 45%, #D95C8C 100%);
}

.theme-dark .hall-header {
  background: linear-gradient(155deg, #3A4C7A 0%, #2A3A63 45%, #1C2947 100%);
}

.hall-search {
  margin-top: 24rpx;
  background: var(--surface);
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 10rpx 0 28rpx;
  box-shadow: 0 16rpx 40rpx rgba(13, 41, 120, 0.25);
}

.search-icon {
  width: 26rpx;
  height: 26rpx;
  border: 4rpx solid #9AA5B8;
  border-radius: 50%;
  position: relative;
  margin-right: 16rpx;
  flex: 0 0 auto;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 14rpx;
  background: #9AA5B8;
  border-radius: 2rpx;
  left: 22rpx;
  top: 20rpx;
  transform: rotate(-45deg);
}

.search-input {
  flex: 1;
  font-size: 27rpx;
  height: 76rpx;
  line-height: 76rpx;
  background: transparent;
}

.search-placeholder {
  color: var(--faint);
}

.search-go {
  flex: 0 0 auto;
  background: var(--brand);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 14rpx 28rpx;
}

/* 实时新帖提示胶囊 */
.new-pill {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  z-index: 60;
  background: var(--brand);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 14rpx 30rpx;
  box-shadow: 0 8rpx 24rpx rgba(23, 35, 61, 0.25);
  transition: top 0.25s ease;
}

/* 内容区：头部收起时补回等量高度，保持文档总高不变，消除滚动跳动 */
.hall-body {
  padding: 20rpx 24rpx calc(160rpx + env(safe-area-inset-bottom));
  transition: padding-top 0.25s ease;
}

.hall-body.pad {
  padding-top: 122rpx;
}

.chips-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 4rpx 0 18rpx;
}

.chips-scroll {
  flex: 1;
  min-width: 0;
}

.chips {
  display: inline-flex;
  align-items: center;
  gap: 14rpx;
}

.chip {
  flex: 0 0 auto;
  font-size: 25rpx;
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: var(--surface);
  color: var(--muted);
  box-shadow: 0 2rpx 10rpx rgba(23, 35, 61, 0.05);
}

.chip.on {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}

.chips-more {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: 0 2rpx 10rpx rgba(23, 35, 61, 0.05);
  color: var(--muted);
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

/* 分类筛选半屏面板 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(23, 35, 61, 0.45);
  z-index: 200;
}

.filter-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: var(--surface);
  border-radius: 28rpx 28rpx 0 0;
  /* 底部留出自定义 tabBar 的高度，确定/重置按钮不被它挡住 */
  padding: 36rpx 32rpx calc(190rpx + env(safe-area-inset-bottom));
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--ink);
}

.sheet-sub {
  margin-left: 14rpx;
  font-size: 23rpx;
  font-weight: 400;
  color: var(--faint);
}

.sheet-tags {
  margin-top: 26rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.sheet-tag {
  font-size: 26rpx;
  padding: 16rpx 34rpx;
  border-radius: 999rpx;
  background: var(--field);
  color: var(--muted);
}

.sheet-tag.on {
  background: var(--brand);
  color: #ffffff;
  font-weight: 600;
}

.sheet-actions {
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
}

.sheet-btn {
  flex: 1;
}

.seg {
  flex: 1;
  display: flex;
  background: var(--field);
  border-radius: 16rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 12rpx 0;
  border-radius: 12rpx;
  color: var(--muted);
}

.seg-item.on {
  background: var(--surface);
  color: var(--ink);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(23, 35, 61, 0.08);
}

.sort-entry {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--surface);
  border-radius: 999rpx;
  padding: 14rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(23, 35, 61, 0.05);
}

.sort-caret {
  font-size: 18rpx;
  color: var(--faint);
}

.login-banner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--brand-soft);
  border-radius: 20rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 20rpx;
}

.login-banner-text {
  font-size: 25rpx;
  color: var(--brand-deep);
}

.login-banner-btn {
  background: var(--brand);
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 12rpx 30rpx;
}

/* 任务卡 */
.post-card {
  background: var(--surface);
  border-radius: var(--radius-card);
  padding: 28rpx 30rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-card);
}

.post-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.side-tag {
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 12rpx;
  padding: 8rpx 18rpx;
}

.side-tag.reward {
  background: var(--reward-soft);
  color: #E14D0B;
}

.side-tag.service {
  background: var(--service-soft);
  color: var(--service);
}

.side-tag.mutual {
  background: var(--green-soft);
  color: #0A9463;
}

.price {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--reward);
}

.price-yuan {
  font-size: 24rpx;
  font-weight: 700;
  margin-right: 2rpx;
}

.price-alt {
  font-size: 27rpx;
  font-weight: 700;
  color: #0A9463;
}

.post-mid {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.post-texts {
  flex: 1;
  min-width: 0;
}

.post-thumb {
  margin-top: 18rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-field);
  background: var(--field);
  flex: 0 0 auto;
}

.post-title {
  margin-top: 18rpx;
  font-size: 33rpx;
  font-weight: 700;
  line-height: 1.4;
  color: var(--ink);
}

.post-desc {
  margin-top: 10rpx;
  font-size: 25rpx;
  color: var(--muted);
  line-height: 1.55;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-foot {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 23rpx;
  color: var(--faint);
}

.ava {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
}

.pub-name {
  color: var(--muted);
  font-weight: 600;
  max-width: 160rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.credit {
  color: #F5A70B;
  font-weight: 600;
}

.due-pill {
  margin-left: auto;
  flex: 0 0 auto;
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 8rpx 18rpx;
}

.list-end {
  text-align: center;
  color: #C2CAD6;
  font-size: 22rpx;
  padding: 20rpx 0 10rpx;
}

.hist-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.hist-chip {
  font-size: 24rpx;
  color: var(--muted);
  background: var(--surface);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  box-shadow: var(--shadow-card);
}

.hist-clear {
  font-size: 22rpx;
  color: var(--faint);
  margin-left: auto;
}
