.target {
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.reviewed {
  margin-bottom: 20rpx;
  color: #d94a1f;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-weight: 650;
}

.stars {
  display: flex;
  align-items: center;
  min-height: 76rpx;
}

.star {
  font-size: 56rpx;
  line-height: 1;
  color: var(--line);
  padding: 4rpx 8rpx;
}

.star.on {
  color: var(--amber);
}

.stars-off {
  opacity: 0.5;
}

.star-hint {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.char-count {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--faint);
}
