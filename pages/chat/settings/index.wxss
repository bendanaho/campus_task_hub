.setting-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--ink);
}

.setting-sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.font-options {
  margin-top: 20rpx;
  display: flex;
  background: var(--field);
  border-radius: 16rpx;
  padding: 6rpx;
}

.font-option {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  color: var(--muted);
}

.font-option.on {
  background: var(--surface);
  color: var(--ink);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(23, 35, 61, 0.08);
}

.tips {
  margin-top: 12rpx;
  text-align: center;
  font-size: 23rpx;
  color: var(--faint);
}
