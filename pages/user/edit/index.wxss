.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-weight: 650;
}

.current {
  margin-bottom: 12rpx;
  color: var(--faint);
  font-size: 24rpx;
}

.verify-text {
  margin-top: 8rpx;
  color: var(--amber);
  font-weight: 700;
}

.verify-text.ok {
  color: var(--green);
}

.verify-link {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}
