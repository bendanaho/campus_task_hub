.form {
  margin-top: 36rpx;
}

.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-weight: 600;
}

/* 密码框 + 显示/隐藏眼睛开关 */
.pwd-wrap {
  position: relative;
}

.pwd-wrap .input {
  padding-right: 88rpx;
}

.pwd-eye {
  position: absolute;
  right: 0;
  top: 0;
  width: 76rpx;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: var(--muted);
}

/* off = 当前为密文，眼睛上加一道斜杠表示“已隐藏” */
.pwd-eye.off::after {
  content: '';
  position: absolute;
  left: 18rpx;
  right: 18rpx;
  top: 50%;
  height: 2rpx;
  background: var(--muted);
  transform: rotate(-45deg);
}
