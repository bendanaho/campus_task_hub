.room {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-head {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.order-line {
  color: var(--brand);
  font-size: 24rpx;
}

.messages {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-bottom: 18rpx;
  overflow: hidden;
}

.msg {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.msg.mine {
  align-items: flex-end;
}

.msg.other {
  align-items: flex-start;
}

.msg.withdrawn-msg {
  align-items: center;
  margin-bottom: 20rpx;
}

.msg-time {
  margin-bottom: 8rpx;
  color: #9aa4b4;
  font-size: 22rpx;
}

.withdrawn-tip {
  color: #9aa4b4;
  font-size: 23rpx;
  line-height: 1.4;
}

.bubble {
  max-width: 78%;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  line-height: 1.55;
}

.mine .bubble {
  background: var(--brand);
  color: #ffffff;
}

.other .bubble {
  background: #ffffff;
  border: 1rpx solid #e6eaf1;
  color: #253044;
}

.withdraw {
  margin-top: 8rpx;
  color: #8a95a6;
  font-size: 22rpx;
}

.payment-title {
  font-weight: 800;
}

.payment-money {
  margin: 12rpx 0;
  font-size: 36rpx;
  font-weight: 850;
}

.payment-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.pay-title {
  margin-bottom: 14rpx;
  font-weight: 800;
}

.pay-box {
  flex: none;
  margin-bottom: 18rpx;
}

.pay-row {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr) 112rpx;
  gap: 12rpx;
  align-items: center;
}

.kind,
.pay-input {
  width: 100%;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: #f6f8fb;
  display: flex;
  align-items: center;
}

.pay-row .btn {
  width: 100%;
  min-width: 0;
  padding: 0;
}

.input-bar {
  flex: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 112rpx;
  gap: 12rpx;
  align-items: center;
}

.message-input {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #dfe4ec;
}

.input-bar .btn {
  width: 100%;
  min-width: 0;
  padding: 0;
}
