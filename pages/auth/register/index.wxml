<view class="page {{themeCls}}">
  <view class="card form">
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" placeholder="例如：王同学" value="{{username}}" data-key="username" bindinput="onInput" maxlength="20" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" data-key="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">邮箱</text>
      <input class="input" placeholder="选填" value="{{email}}" data-key="email" bindinput="onInput" maxlength="50" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <view class="pwd-wrap">
        <input class="input" password="{{!showPwd}}" placeholder="至少 6 位" value="{{password}}" data-key="password" bindinput="onInput" maxlength="32" />
        <view class="pwd-eye {{showPwd ? '' : 'off'}}" bindtap="togglePwd" aria-label="{{showPwd ? '隐藏密码' : '显示密码'}}">👁</view>
      </view>
    </view>
    <view class="field">
      <text class="label">确认密码</text>
      <input class="input" password="{{!showPwd}}" placeholder="请再次输入密码" value="{{confirmPassword}}" data-key="confirmPassword" bindinput="onInput" maxlength="32" />
    </view>
    <button class="btn" bindtap="submit" disabled="{{submitting}}" loading="{{submitting}}">创建账号</button>
  </view>
</view>
