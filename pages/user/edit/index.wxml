<view class="page">
  <view class="card section">
    <view class="label">头像</view>
    <view class="avatar-row">
      <ua-avatar avatar="{{avatarValue}}" name="{{username}}" uid="{{uid}}" size="{{140}}" />
      <view class="avatar-ops">
        <view class="btn secondary small avatar-btn" hover-class="btn-hover" bindtap="pickAvatarImage">上传图片</view>
        <view wx:if="{{hasCustomAvatar}}" class="avatar-reset" bindtap="resetAvatar">恢复默认</view>
      </view>
    </view>
    <view class="label swatch-label">纯色模板</view>
    <view class="swatches">
      <view
        wx:for="{{colors}}"
        wx:key="*this"
        class="swatch {{avatarValue === 'color:' + item ? 'on' : ''}}"
        style="background: {{item}};"
        bindtap="pickColor"
        data-color="{{item}}"
      ></view>
    </view>
    <view class="avatar-tip">头像暂时只保存在本机（后端还没有头像接口，就绪后可同步）</view>
  </view>

  <view class="card form section">
    <view class="field">
      <text class="label">手机号</text>
      <view class="current">当前：{{phoneMasked}}</view>
      <input
        class="input"
        type="number"
        maxlength="11"
        placeholder="{{phoneMasked}}"
        value="{{phone}}"
        data-key="phone"
        bindinput="onInput"
      />
    </view>
    <view class="field">
      <text class="label">邮箱</text>
      <view class="current">当前：{{emailMasked}}</view>
      <input
        class="input"
        placeholder="{{emailMasked}}"
        value="{{email}}"
        data-key="email"
        bindinput="onInput"
      />
    </view>
    <button class="btn" disabled="{{submitting}}" loading="{{submitting}}" bindtap="save">保存</button>
  </view>

  <view class="card section">
    <view class="space-between">
      <view>
        <view class="label">实名状态</view>
        <view class="verify-text {{verified ? 'ok' : ''}}">{{verified ? '已实名认证' : '未实名'}}</view>
      </view>
      <view wx:if="{{!verified}}" class="verify-link" hover-class="btn-hover" bindtap="goVerify">去实名 ›</view>
    </view>
  </view>
</view>
