<view class="page">
  <view class="card form">
    <view class="field">
      <text class="label">用户名</text>
      <input class="input" placeholder="例如：王同学" value="{{username}}" data-key="username" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">手机号</text>
      <input class="input" type="number" maxlength="11" placeholder="11 位手机号" value="{{phone}}" data-key="phone" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">邮箱</text>
      <input class="input" placeholder="选填" value="{{email}}" data-key="email" bindinput="onInput" />
    </view>
    <view class="field">
      <text class="label">密码</text>
      <input class="input" password placeholder="请输入密码" value="{{password}}" data-key="password" bindinput="onInput" />
    </view>
    <button class="btn" bindtap="submit">创建账号</button>
  </view>
</view>
