.guest {
  margin-top: 90rpx;
  text-align: center;
}

.guest-title {
  font-size: 34rpx;
  font-weight: 800;
}

.guest-btn {
  margin-top: 28rpx;
}

/* 三大主标签 */
.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.tab {
  position: relative;
  min-height: 108rpx;
  border-radius: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--muted);
  font-size: 26rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.tab-icon {
  font-size: 40rpx;
  line-height: 1;
}

.tab-text {
  font-size: 26rpx;
}

.tab.active {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
  font-weight: 700;
}

/* 二级筛选 chip */
.subtabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.subchip {
  font-size: 24rpx;
  color: var(--muted);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}

.subchip.on {
  background: var(--brand-soft);
  border-color: var(--brand);
  color: var(--brand);
  font-weight: 700;
}

/* 筛选漏斗入口 */
.filter-entry {
  position: relative;
  flex: 0 0 auto;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--surface);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-entry.active {
  background: var(--brand-soft);
}

.funnel {
  position: relative;
  width: 28rpx;
  height: 28rpx;
}

.funnel::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 2rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 13rpx solid var(--muted);
}

.funnel::after {
  content: '';
  position: absolute;
  top: 17rpx;
  left: 12rpx;
  width: 4rpx;
  height: 9rpx;
  background: var(--muted);
  border-radius: 2rpx;
}

.filter-entry.active .funnel::before {
  border-top-color: var(--brand);
}

.filter-entry.active .funnel::after {
  background: var(--brand);
}

/* 筛选激活小红点 */
.filter-entry.active::after {
  content: '';
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--reward);
}

/* 筛选面板 */
.filter-panel {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: var(--radius-field);
  box-shadow: var(--shadow-card);
  padding: 24rpx;
}

.filter-panel .fp-title {
  margin: 22rpx 0 14rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--muted);
}

.filter-panel .fp-title:first-child {
  margin-top: 0;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.chip {
  font-size: 24rpx;
  color: var(--muted);
  background: var(--field);
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}

.chip.on {
  background: var(--brand);
  color: #ffffff;
  font-weight: 700;
}

.amount {
  color: var(--reward);
  font-size: 34rpx;
  font-weight: 850;
}

/* 我发布的：帖子状态标 + 报酬 */
.post-status {
  font-size: 22rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.post-status.open {
  background: var(--green-soft);
  color: #0A9463;
}

.post-status.closed {
  background: var(--field);
  color: var(--faint);
}

.post-reward {
  color: var(--reward);
  font-weight: 700;
}

.title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.meta {
  margin-top: 16rpx;
  color: var(--faint);
  font-size: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: var(--shadow-card);
}

.search-icon {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid var(--faint);
  border-radius: 50%;
  position: relative;
  flex: 0 0 auto;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 12rpx;
  background: var(--faint);
  border-radius: 2rpx;
  left: 18rpx;
  top: 16rpx;
  transform: rotate(-45deg);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.waiting-tip {
  margin-top: 18rpx;
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
}

.actions {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
}

/* 原生 button 默认撑满整行，这里压回弹性布局；允许换行避免多按钮时被挤窄截断 */
.actions .btn {
  flex: 1 1 auto;
  min-width: 150rpx;
  width: auto;
  padding-left: 12rpx;
  padding-right: 12rpx;
}

.order-del-hit {
  flex: 0 0 auto;
  width: 88rpx;
  height: 88rpx;
  margin: -16rpx -16rpx -16rpx auto;
  display: flex;
  align-items: center;
  justify-content: center;
}

.order-del {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--reward-soft);
  color: #E14D0B;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hidden-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.hidden-tip {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: var(--faint);
}

.hidden-toggle {
  flex: 0 0 auto;
  margin-left: auto;
  font-size: 24rpx;
  color: var(--brand);
  background: var(--brand-soft);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

.hist-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.hist-chip {
  font-size: 24rpx;
  color: var(--muted);
  background: var(--surface);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
  box-shadow: var(--shadow-card);
}

.hist-clear {
  font-size: 22rpx;
  color: var(--faint);
  margin-left: auto;
}
