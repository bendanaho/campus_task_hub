<view class="page {{themeCls}}">
  <view wx:if="{{offline}}" class="offline-banner">网络连接已断开，请检查网络</view>
  <view wx:elif="{{authExpired}}" class="auth-expired-banner" bindtap="onReLogin">登录已过期，点此重新登录</view>
  <view wx:if="{{!loggedIn}}" class="card guest">
    <view class="guest-title">还没有登录</view>
    <view class="muted">登录后可以发布任务、查看订单和消息。</view>
    <button class="btn login-btn" bindtap="goLogin">去登录</button>
  </view>

  <block wx:else>
    <view class="profile card section">
      <view class="avatar-wrap" bindtap="changeAvatar" aria-role="button" aria-label="点击更换头像">
        <ua-avatar avatar="{{user.avatarShow}}" name="{{user.username}}" uid="{{user.id}}" size="{{100}}" />
        <view class="avatar-edit">换</view>
      </view>
      <view class="profile-main">
        <view class="name">{{user.username}}</view>
        <view class="muted">信用分 {{user.creditScore}}</view>
        <view class="verify {{user.verifyClass}}">
          {{user.verifyText}}
        </view>
      </view>
    </view>

    <view class="wallet card section">
      <view>
        <view class="muted">账户余额</view>
        <view class="balance">¥{{balance}}</view>
        <view wx:if="{{balanceError}}" class="balance-error" bindtap="reloadBalance" aria-role="button" aria-label="余额更新失败，点击重试">更新失败 · 点击重试</view>
      </view>
      <button class="btn secondary small" bindtap="goWallet">充值</button>
    </view>

    <view class="card section">
      <view class="appearance-title">外观</view>
      <view class="mode-seg">
        <view class="mode-item {{theme.mode === 'light' ? 'on' : ''}}" bindtap="setLight" aria-role="button" aria-label="浅色模式{{theme.mode === 'light' ? '，已选中' : ''}}">浅色</view>
        <view class="mode-item {{theme.mode === 'dark' ? 'on' : ''}}" bindtap="setDark" aria-role="button" aria-label="深色模式{{theme.mode === 'dark' ? '，已选中' : ''}}">深色</view>
      </view>
      <block wx:if="{{theme.mode === 'light'}}">
        <view class="palette-row">
          <view class="appearance-sub">背景色</view>
          <view
            class="palette-toggle {{showPalette ? 'on' : ''}}"
            bindtap="togglePalette"
            aria-role="button"
            aria-label="{{showPalette ? '收起调色盘' : '展开调色盘'}}"
          >🎨</view>
        </view>
        <view wx:if="{{showPalette}}" class="bg-swatches">
          <view
            wx:for="{{bgs}}"
            wx:key="value"
            class="bg-swatch {{theme.bg === item.value ? 'on' : ''}}"
            style="background: {{item.color}};"
            bindtap="pickBg"
            data-value="{{item.value}}"
            aria-role="button"
            aria-label="背景色 {{item.label}}{{theme.bg === item.value ? '，已选中' : ''}}"
          ></view>
        </view>
      </block>
    </view>

    <view class="card menu section">
      <view wx:if="{{user.role === 1}}" class="menu-item admin-item" bindtap="goAdmin">
        <text>🛡️ 管理后台</text>
        <text class="muted">仲裁 / 举报</text>
      </view>
      <view class="menu-item" bindtap="goMine">
        <text>我的发布</text>
        <text class="muted">查看</text>
      </view>
      <view class="menu-item" bindtap="goMyReviews">
        <text>我的评价</text>
        <text class="muted">查看</text>
      </view>
      <view class="menu-item" bindtap="goBills">
        <text>账单流水</text>
        <text class="muted">查看</text>
      </view>
      <view class="menu-item" bindtap="goVerify">
        <text>实名认证</text>
        <text class="muted">{{user.verifyActionText}}</text>
      </view>
      <view class="menu-item" bindtap="goEdit">
        <text>编辑资料</text>
        <text class="muted">去修改</text>
      </view>
    </view>

    <button class="btn ghost logout" bindtap="logout">退出登录</button>
  </block>
</view>
