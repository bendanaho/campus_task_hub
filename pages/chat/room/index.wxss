.room {
  /* 真机上弹性列容器必须是"确定高度"，否则 flex:1 的消息滚动区会塌成 0 高、消息不可见。
     min-height 不算确定高度（DevTools 能容忍、真机不行），这里用 height。 */
  height: 100vh;
  box-sizing: border-box;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-head {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.order-line {
  color: var(--brand);
  font-size: 24rpx;
}

.head-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mini-tag {
  background: var(--green-soft);
  color: var(--green);
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

/* 可点的"有新评价"胶囊：与纯状态标记(交易成功)视觉区分，并放大点击区 */
.review-link {
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  padding: 10rpx 22rpx;
  background: var(--surface);
  border: 1rpx solid var(--brand);
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 700;
  border-radius: 999rpx;
}

.head-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-entry {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}

.review-btn {
  background: var(--brand);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}

.messages {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-bottom: 18rpx;
  overflow: hidden;
}

/* 加载骨架气泡 */
.sk-bubble {
  height: 72rpx;
  width: 44%;
  border-radius: 14rpx;
  background: var(--field);
  margin-bottom: 26rpx;
  animation: chat-sk-pulse 1.2s ease-in-out infinite;
}

.sk-bubble.wide {
  width: 62%;
}

.sk-bubble.side-mine {
  margin-left: auto;
}

@keyframes chat-sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.msg {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.msg.mine {
  align-items: flex-end;
}

.msg.other {
  align-items: flex-start;
}

.msg.withdrawn-msg {
  align-items: center;
  margin-bottom: 20rpx;
}

.msg.system-msg {
  align-items: center;
  margin-bottom: 20rpx;
}

.system-tip {
  background: var(--field);
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  max-width: 86%;
  text-align: center;
}

/* 聊天字号（消息设置里可调） */
.messages.font-small .bubble {
  font-size: 24rpx;
}

.messages.font-large .bubble {
  font-size: 34rpx;
}

.msg-time {
  margin-bottom: 8rpx;
  color: var(--faint);
  font-size: 22rpx;
}

.withdrawn-tip {
  color: var(--faint);
  font-size: 23rpx;
  line-height: 1.4;
}

.bubble-row {
  max-width: 78%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bubble {
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  line-height: 1.55;
}

.bubble.pending {
  opacity: 0.65;
}

/* 发送失败：气泡描边标红 + 下方可见文案；整条气泡与文案均可点重发 */
.bubble.is-failed {
  border: 1rpx solid var(--reward);
}

.failed-hint {
  margin-top: 8rpx;
  min-height: 44rpx;
  padding: 6rpx 4rpx;
  display: flex;
  align-items: center;
  color: var(--reward);
  font-size: 22rpx;
  font-weight: 600;
}

.mine .bubble {
  background: var(--brand);
  color: #ffffff;
}

.other .bubble {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--ink);
}

/* 图片消息：去掉气泡底色/边框/内边距，直接展示图片本身 */
.mine .bubble.is-image,
.other .bubble.is-image {
  padding: 0;
  background: transparent;
  border: none;
}

.msg-image {
  display: block;
  width: 340rpx;
  max-width: 60vw;
  border-radius: 14rpx;
  background: var(--field);
}

/* 金额内联在类型后面：转账 ¥50.00 */
.pay-headline {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  font-weight: 800;
}

.pay-kind {
  font-size: 30rpx;
}

.pay-amount {
  font-size: 34rpx;
  font-weight: 850;
}

/* 转账说明（后端返回 note 时显示，无则整行不渲染）；用继承色 + 透明度，
   使其在“我方”粉底白字与“对方”白底深字两种气泡里都清晰 */
.pay-note {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 1.4;
  opacity: 0.9;
}

.pay-status {
  margin-top: 8rpx;
  font-size: 23rpx;
  opacity: 0.75;
}

.payment-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.pay-title {
  margin-bottom: 14rpx;
  font-weight: 800;
}

.pay-box {
  flex: none;
  margin-bottom: 18rpx;
}

.pay-row {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr) 112rpx;
  gap: 12rpx;
  align-items: center;
}

.kind,
.pay-input {
  width: 100%;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: var(--field);
  display: flex;
  align-items: center;
}

.pay-row .btn {
  width: 100%;
  min-width: 0;
  padding: 0;
}

/* 仿微信：输入框在左，右侧「表情」「+」；发送走键盘回车/表情面板内发送键 */
.input-bar {
  flex: none;
  display: grid;
  grid-template-columns: minmax(0, 1fr) 68rpx 68rpx;
  gap: 12rpx;
  align-items: center;
}

.io-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 「+」按钮用主题强调色，随换肤一起变色 */
.io-plus {
  color: var(--brand);
  border-color: var(--brand-soft);
  background: var(--brand-soft);
  font-weight: 700;
}

.io-btn.active {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
}

/* 「+」面板：转账 / 图片，仿微信九宫格入口 */
.more-panel {
  flex: none;
  margin-bottom: 14rpx;
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 24rpx 16rpx;
  display: flex;
  gap: 32rpx;
}

.more-item {
  width: 128rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.more-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 24rpx;
  background: var(--field);
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.more-label {
  font-size: 24rpx;
  color: var(--muted);
}

.emoji-panel {
  flex: none;
  position: relative;
  /* 面板已上移到输入栏上方，与输入栏之间留出间距 */
  margin-bottom: 14rpx;
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 16rpx;
}

/* 表情多了以后面板限高滚动，不挤没消息区 */
.emoji-scroll {
  max-height: 420rpx;
}

.emoji-grid {
  display: flex;
  flex-wrap: wrap;
}

.emoji-item {
  width: 12.5%;
  text-align: center;
  font-size: 44rpx;
  line-height: 1;
  padding: 14rpx 0;
}

/* 面板内发送键：输入非空时出现（键盘收起也能发出纯表情消息） */
.emoji-send {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  background: var(--brand);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 12rpx 34rpx;
  box-shadow: var(--shadow-card);
}

.message-input {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.input-bar .btn {
  width: 100%;
  min-width: 0;
  padding: 0;
}

.quick-row {
  flex: none;
  margin-bottom: 14rpx;
  width: 100%;
}

.quick-inner {
  display: inline-flex;
  gap: 14rpx;
}

.quick-chip {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}

/* 图片消息加载失败提示（点击仍可预览强制拉取） */
.img-fail-hint {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--faint);
}

/* 灰底占位给个最小高度，加载中不至于塌成细条 */
.msg-image {
  min-height: 200rpx;
}

/* 会话内就地订单操作 */
.order-line {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.order-line .order-act {
  margin: 0;
  min-height: 52rpx;
  line-height: 52rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
}

.order-wait {
  font-size: 22rpx;
  color: var(--muted);
}

/* 会话内申诉入口：弱化为文字链，不与主操作(确认完成)抢视觉 */
.order-dispute {
  font-size: 22rpx;
  color: var(--reward);
  text-decoration: underline;
  padding: 6rpx 4rpx;
}

/* 购买按钮靠最右：说明文字占左侧，按钮 margin-left:auto 推到最右 */
.buy-line {
  flex-wrap: nowrap;
}

.buy-line .order-wait {
  flex: 1;
  min-width: 0;
}

.buy-btn {
  margin-left: auto;
  flex: 0 0 auto;
}

/* 已评价标记：与"交易成功"绿标区分，用中性灰 */
.reviewed-tag {
  background: var(--field);
  color: var(--muted);
}
