.tabs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.tab {
  min-height: 66rpx;
  border-radius: 10rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--muted);
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab.active {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
  font-weight: 700;
}

.amount {
  color: var(--reward);
  font-size: 34rpx;
  font-weight: 850;
}

.d-title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.d-meta {
  margin-top: 12rpx;
  color: var(--faint);
  font-size: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.d-reason {
  margin-top: 16rpx;
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 24rpx;
  line-height: 1.5;
  border-radius: 12rpx;
  padding: 14rpx 20rpx;
}

.card .btn {
  margin-top: 22rpx;
}

.r-item {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: var(--muted);
  line-height: 1.5;
}

.r-name {
  color: var(--ink);
  font-weight: 600;
}

.r-time {
  margin-left: 12rpx;
  color: var(--faint);
  font-size: 21rpx;
}

.d-actions {
  margin-top: 22rpx;
  display: flex;
  gap: 14rpx;
}

.d-actions .btn {
  flex: 1;
  margin-top: 0;
}
