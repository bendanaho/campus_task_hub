<view class="page room {{themeCls}}" style="{{kbHeight ? 'padding-bottom:' + kbHeight + 'px' : ''}}">
  <view class="card section chat-head">
    <view class="head-row">
      <view class="strong">{{partnerName || '会话'}}</view>
      <text wx:if="{{tradeDone}}" class="mini-tag">交易成功</text>
      <view wx:if="{{hasNewReview}}" class="review-link" hover-class="btn-hover" bindtap="goMyReviews" aria-role="button" aria-label="查看我的新评价">有新评价 ›</view>
    </view>
    <view wx:if="{{!isSystemChat}}" class="muted">{{taskTitle || '未关联帖子'}}</view>
    <!-- 无活跃订单时的就地下单入口：下单即托管冻结，双方确认完成自动转账，完成后此处变成"去评价" -->
    <view wx:if="{{buyLabel}}" class="order-line buy-line">
      <text class="order-wait">下单后款项托管，确认完成自动转给对方</text>
      <button class="btn small order-act buy-btn" bindtap="buyNow">{{buyLabel}}</button>
    </view>
    <!-- 订单动作就地完成：待接受→确认下单；进行中→确认完成；双方确认后自动结算转钱、直接完成 -->
    <view wx:if="{{activeOrder}}" class="order-line">
      <text>订单：{{activeOrder.statusText}} / ¥{{activeOrder.amountText}}</text>
      <button wx:if="{{activeOrder.canAcceptHere}}" class="btn small order-act" bindtap="acceptActiveOrder">确认下单</button>
      <button wx:if="{{activeOrder.canConfirmHere}}" class="btn small order-act" bindtap="confirmActiveOrder">{{activeOrder.confirmLabel || '确认完成'}}</button>
      <text wx:if="{{activeOrder.waitingAccept}}" class="order-wait">等待对方确认下单</text>
      <text wx:if="{{activeOrder.waitingOther}}" class="order-wait">你已确认，等对方确认后自动结算</text>
      <text wx:if="{{activeOrder.canDisputeHere}}" class="order-dispute" bindtap="disputeActiveOrder" aria-role="button" aria-label="向管理员申诉">有问题？申诉</text>
      <text wx:if="{{activeOrder.isDisputed}}" class="order-wait">申诉已提交，资金冻结中，等待管理员裁决</text>
    </view>
    <view wx:if="{{!isSystemChat && (canReview || reviewedDone)}}" class="head-actions">
      <view wx:if="{{canReview}}" class="review-btn" hover-class="btn-hover" bindtap="goReview">去评价对方</view>
      <text wx:elif="{{reviewedDone}}" class="mini-tag reviewed-tag">已评价</text>
    </view>
  </view>

  <scroll-view class="messages section {{fontClass}}" scroll-y scroll-into-view="{{intoView}}" enhanced show-scrollbar="{{false}}" bindscroll="onMessagesScroll">
    <block wx:if="{{loading}}">
      <view class="sk-bubble side-other"></view>
      <view class="sk-bubble side-mine"></view>
      <view class="sk-bubble side-other wide"></view>
    </block>
    <view wx:elif="{{messages.length == 0}}" class="empty">暂无消息</view>
    <view wx:for="{{messages}}" wx:key="id" id="msg-{{item.id}}" class="msg {{item.withdrawn ? 'withdrawn-msg' : (item.isSystem ? 'system-msg' : item.bubbleClass)}}">
      <view wx:if="{{item.showTime}}" class="msg-time">{{item.showTime}}</view>
      <view wx:if="{{item.withdrawn}}" class="withdrawn-tip">消息已撤回</view>
      <view wx:elif="{{item.isSystem}}" class="system-tip">{{item.content}}</view>
      <block wx:else>
        <view class="bubble-row">
          <view class="bubble {{item.isImage ? 'is-image' : ''}} {{item.pending ? 'pending' : ''}} {{item.failed ? 'is-failed' : ''}}" data-id="{{item.id}}" bindtap="onBubbleTap" bindlongpress="onBubbleLongpress">
            <block wx:if="{{item.type == 'payment'}}">
              <view class="pay-headline">
                <text class="pay-kind">{{item.paymentTitle}}</text>
                <text class="pay-amount">¥{{item.paymentAmountText}}</text>
              </view>
              <view wx:if="{{item.paymentNote}}" class="pay-note">{{item.paymentNote}}</view>
              <view class="pay-status">{{item.paymentStatusText}}</view>
              <view wx:if="{{item.canPay || item.canCancelPayment}}" class="payment-actions">
                <button wx:if="{{item.canPay}}" class="btn small" data-id="{{item.id}}" bindtap="payCard">支付</button>
                <button wx:if="{{item.canCancelPayment}}" class="btn warn small" data-id="{{item.id}}" bindtap="cancelCard">取消</button>
              </view>
            </block>
            <block wx:elif="{{item.isImage}}">
              <image
                class="msg-image"
                src="{{item.imageUrl}}"
                mode="widthFix"
                catchtap="onImageTap"
                binderror="onImageLoadError"
                data-id="{{item.id}}"
                data-index="{{index}}"
              />
              <view wx:if="{{item.imageFailed}}" class="img-fail-hint" catchtap="onImageTap" data-id="{{item.id}}">图片加载失败{{item.imageFailMsg ? '（' + item.imageFailMsg + '）' : ''}} · 点击查看</view>
            </block>
            <block wx:else>
              <view>{{item.content}}</view>
            </block>
          </view>
        </view>
        <view wx:if="{{item.failed}}" class="failed-hint" data-id="{{item.id}}" bindtap="resendLocal" aria-role="button" aria-label="发送失败，点击重发">发送失败 点击重发</view>
      </block>
    </view>
  </scroll-view>

  <view wx:if="{{!isSystemChat && showPay}}" class="card section pay-box">
    <view class="pay-title">支付卡片</view>
    <view class="pay-row">
      <picker range="{{paymentKinds}}" range-key="label" value="{{paymentKindIndex}}" bindchange="onKindChange">
        <view class="kind">{{paymentKinds[paymentKindIndex].label}}</view>
      </picker>
      <input class="pay-input" type="digit" placeholder="金额" value="{{payAmount}}" bindinput="onAmountInput" />
      <button class="btn small" bindtap="sendPayment">发送</button>
    </view>
  </view>

  <scroll-view wx:if="{{!isSystemChat && inputFocused}}" class="quick-row" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="quick-inner">
      <view wx:for="{{quickPhrases}}" wx:key="*this" class="quick-chip" hover-class="btn-hover" bindtap="sendQuick" data-text="{{item}}">{{item}}</view>
    </view>
  </scroll-view>

  <view wx:if="{{showEmoji && !isSystemChat}}" class="emoji-panel">
    <scroll-view class="emoji-scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view class="emoji-grid">
        <view
          wx:for="{{emojis}}"
          wx:key="*this"
          class="emoji-item"
          hover-class="btn-hover"
          bindtap="onEmojiTap"
          data-emoji="{{item}}"
        >{{item}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{input}}" class="emoji-send" catchtap="sendText" aria-role="button" aria-label="发送">发送</view>
  </view>

  <view wx:if="{{showMore && !isSystemChat}}" class="more-panel">
    <view class="more-item" hover-class="btn-hover" bindtap="onMoreTransfer" aria-role="button" aria-label="转账">
      <view class="more-icon">💰</view>
      <view class="more-label">转账</view>
    </view>
    <view class="more-item" hover-class="btn-hover" bindtap="onMoreImage" aria-role="button" aria-label="发送图片">
      <view class="more-icon">🖼️</view>
      <view class="more-label">图片</view>
    </view>
  </view>

  <view wx:if="{{!isSystemChat}}" class="input-bar">
    <input class="message-input" placeholder="输入消息，回车发送" value="{{input}}" adjust-position="{{false}}" bindkeyboardheightchange="onKbHeightChange" bindinput="onInput" bindfocus="onInputFocus" bindblur="onInputBlur" confirm-type="send" confirm-hold="{{true}}" bindconfirm="sendText" />
    <view class="io-btn" hover-class="btn-hover" bindtap="toggleEmoji" aria-role="button" aria-label="表情">😊</view>
    <view class="io-btn io-plus {{showMore ? 'active' : ''}}" hover-class="btn-hover" bindtap="toggleMore" aria-role="button" aria-label="更多，转账或图片">＋</view>
  </view>
</view>
