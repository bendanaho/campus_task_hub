# 生产环境 / MySQL 配置（模板）
#
# 使用方式：
#   1. 复制本文件为 application-prod.yml（同目录下）
#   2. 把 password 改成你的 MySQL 实际密码
#   3. application-prod.yml 已在 .gitignore 中，不会被提交，每人本地各自维护
#
# 启动：mvn spring-boot:run -Dspring-boot.run.profiles=prod
#
# 注意：
#   1. password - 替换为实际数据库密码（请勿提交真实密码）
#   2. useSSL - 公网生产环境建议启用 TLS（改为 true 并配置证书）；本地/校园服务器用 false
#   3. 建议使用环境变量注入敏感配置（如 ${DB_PASSWORD}）

spring:
  datasource:
    url: jdbc:mysql://localhost:3306/campus_task_hub?useUnicode=true&serverTimezone=Asia/Shanghai&useSSL=false&characterEncoding=utf8
    driver-class-name: com.mysql.cj.jdbc.Driver
    username: root
    password: your_password_here
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQLDialect
