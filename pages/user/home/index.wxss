.guest {
  margin-top: 90rpx;
  text-align: center;
}

.guest-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.login-btn {
  margin-top: 30rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
}

.profile-main {
  flex: 1;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
}

.verify {
  margin-top: 12rpx;
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #fff2e8;
  color: #cf5f1f;
  font-size: 23rpx;
}

.verify.ok {
  background: #eaf8ef;
  color: #23824a;
}

.wallet {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.balance {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 850;
  color: #162033;
}

.menu-item {
  min-height: 92rpx;
  border-bottom: 1rpx solid #edf0f5;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-item:last-child {
  border-bottom: 0;
}

.logout {
  margin-top: 28rpx;
}
