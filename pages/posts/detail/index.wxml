<view class="page">
  <view wx:if="{{loading}}" class="empty">正在加载详情...</view>

  <block wx:elif="{{task}}">
    <view class="card section">
      <view class="space-between">
        <view class="tag">{{task.sideText}}</view>
        <view class="reward">¥{{task.moneyText}}</view>
      </view>
      <view class="title">{{task.title}}</view>
      <view class="desc">{{task.description}}</view>
      <view wx:if="{{task.images.length > 0}}" class="task-imgs">
        <image
          wx:for="{{task.images}}"
          wx:key="index"
          class="task-img {{task.images.length === 1 ? 'single' : ''}}"
          src="{{item}}"
          mode="aspectFill"
          bindtap="previewImage"
          data-index="{{index}}"
        />
      </view>
      <view class="info-grid">
        <view>
          <text class="label">发布者</text>
          <text>{{task.publisherName}}</text>
        </view>
        <view>
          <text class="label">信用分</text>
          <text>{{task.publisherCredit}}</text>
        </view>
        <view>
          <text class="label">发布时间</text>
          <text>{{task.publishText}}</text>
        </view>
        <view wx:if="{{task.deadlineText}}">
          <text class="label">截止时间</text>
          <text>{{task.deadlineText}}</text>
        </view>
        <view wx:if="{{task.serviceTime}}">
          <text class="label">服务时间</text>
          <text>{{task.serviceTime}}</text>
        </view>
        <view>
          <text class="label">联系方式</text>
          <text>{{task.contact}}</text>
        </view>
      </view>
    </view>

    <view class="card section" hover-class="card-hover" bindtap="goPublisherProfile">
      <view class="publisher-title">发布者信息</view>
      <view class="publisher">
        <ua-avatar avatar="{{publisher.avatar}}" name="{{publisher.username || task.publisherName}}" uid="{{publisher.id}}" size="{{84}}" />
        <view>
          <view class="strong">{{publisher.username || task.publisherName}}</view>
          <view class="muted">信用分 {{publisher.creditScore || task.publisherCredit}}</view>
        </view>
        <view class="publisher-arrow">›</view>
      </view>
    </view>

    <view class="section actions">
      <button class="btn secondary" bindtap="contactPublisher">联系 TA</button>
      <button class="btn" bindtap="respondPost">响应帖子</button>
    </view>

    <view class="card section">
      <view class="publisher-title">收到的评价</view>
      <view wx:if="{{reviews.length == 0}}" class="review-empty">暂无评价</view>
      <view wx:for="{{reviews}}" wx:key="id" class="review">
        <view class="space-between">
          <text class="strong">{{item.fromUserName}}</text>
          <text class="score">{{item.rating}} 星</text>
        </view>
        <view class="review-content">{{item.content || '用户未填写评价内容'}}</view>
        <view class="muted time">{{item.timeText}}</view>
      </view>
      <view wx:if="{{reviewsTotal > 2}}" class="reviews-more" hover-class="btn-hover" bindtap="goAllReviews">查看全部 {{reviewsTotal}} 条评价 ›</view>
    </view>
  </block>
</view>
