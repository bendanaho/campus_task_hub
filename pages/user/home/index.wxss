.guest {
  margin-top: 90rpx;
  text-align: center;
}

.guest-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.login-btn {
  margin-top: 30rpx;
}

.profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
  line-height: 0;
}

.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 8rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  border: 3rpx solid var(--surface);
  background: var(--brand);
  color: #ffffff;
  font-size: 20rpx;
  line-height: 30rpx;
  text-align: center;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
}

.profile-main {
  flex: 1;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
}

.verify {
  margin-top: 12rpx;
  display: inline-flex;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 23rpx;
}

.verify.ok {
  background: var(--green-soft);
  color: var(--green);
}

.wallet {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.balance {
  margin-top: 8rpx;
  font-size: 42rpx;
  font-weight: 850;
  color: var(--ink);
}

.balance-error {
  margin-top: 8rpx;
  display: inline-flex;
  align-items: center;
  min-height: 48rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: var(--reward);
}

.menu-item {
  min-height: 92rpx;
  border-bottom: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.menu-item:last-child {
  border-bottom: 0;
}

.logout {
  margin-top: 28rpx;
}

.appearance-title {
  font-size: 30rpx;
  font-weight: 700;
}

.appearance-sub {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: var(--faint);
}

.mode-seg {
  margin-top: 18rpx;
  display: flex;
  background: var(--field);
  border-radius: 16rpx;
  padding: 6rpx;
}

.mode-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  padding: 14rpx 0;
  border-radius: 12rpx;
  color: var(--muted);
}

.mode-item.on {
  background: var(--surface);
  color: var(--ink);
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(23, 35, 61, 0.08);
}

.palette-row {
  margin-top: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.palette-row .appearance-sub {
  margin-top: 0;
}

.palette-toggle {
  width: 60rpx;
  height: 60rpx;
  border-radius: 16rpx;
  background: var(--field);
  border: 1rpx solid var(--line);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.palette-toggle.on {
  background: var(--brand-soft);
  border-color: var(--brand);
}

.bg-swatches {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.bg-swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 3rpx solid var(--line);
  box-sizing: border-box;
}

.bg-swatch.on {
  border-color: var(--brand);
  border-width: 6rpx;
}
