.profile {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: var(--brand);
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: 800;
}

.profile-main {
  flex: 1;
}

.name-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.name {
  font-size: 38rpx;
  font-weight: 800;
}

.credit {
  margin-top: 12rpx;
  color: var(--amber);
  font-size: 26rpx;
  font-weight: 700;
}

.block-title {
  margin-bottom: 22rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.info-row {
  display: flex;
  gap: 20rpx;
  padding: 12rpx 0;
  color: var(--ink);
}

.info-label {
  flex-shrink: 0;
  width: 100rpx;
  color: var(--muted);
  font-size: 26rpx;
}

.bio {
  flex: 1;
  line-height: 1.6;
}

.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-img {
  width: 210rpx;
  height: 210rpx;
  border-radius: 14rpx;
  background: var(--field);
}

.review {
  padding: 22rpx 0;
  border-top: 1rpx solid var(--line);
}

.review:first-of-type {
  border-top: 0;
}

.review-empty {
  color: var(--faint);
  padding: 26rpx 0;
}

.review-content {
  margin-top: 12rpx;
  color: var(--muted);
  line-height: 1.5;
}

.score {
  color: var(--amber);
  font-weight: 700;
}

.time {
  margin-top: 10rpx;
  font-size: 23rpx;
}

.reviews-more {
  margin-top: 8rpx;
  padding: 22rpx 0 4rpx;
  border-top: 1rpx solid var(--line);
  text-align: center;
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}
