<view class="hall {{themeCls}}">
  <view wx:if="{{offline}}" class="offline-banner">网络连接已断开，请检查网络</view>
  <view wx:elif="{{authExpired}}" class="auth-expired-banner" bindtap="onReLogin">登录已过期，点此重新登录</view>
  <view class="hall-header {{collapsed ? 'collapsed' : ''}}" style="padding-top: {{statusBarHeight}}px;">
    <view class="hall-nav"></view>
    <view class="hall-title">校园互助</view>
    <view class="hall-subtitle">帮你找到愿意搭把手的同学</view>
    <view class="hall-search">
      <view class="search-icon"></view>
      <input
        class="search-input"
        placeholder="搜索任务、服务或同学"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        bindfocus="onSearchFocus"
        bindblur="onSearchBlur"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view wx:if="{{keyword}}" class="search-clear" catchtap="onClearKeyword">✕</view>
      <view wx:if="{{keyword}}" class="search-go" catchtap="onSearch">搜索</view>
    </view>
  </view>

  <view
    wx:if="{{hasNewPosts}}"
    class="new-pill"
    style="top: calc({{statusBarHeight}}px + {{collapsed ? '210rpx' : '330rpx'}});"
    bindtap="refreshFromPill"
  >有新任务 · 点击刷新</view>

  <view class="hall-body {{collapsed ? 'pad' : ''}}">
    <view wx:if="{{searchFocus && !keyword && searchHistory.length > 0}}" class="hist-row">
      <view wx:for="{{searchHistory}}" wx:key="*this" class="hist-chip" catchtap="onHistTap" data-term="{{item}}">{{item}}</view>
      <view class="hist-clear" catchtap="onHistClear">清空</view>
    </view>
    <view class="chips-row">
      <scroll-view class="chips-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="chips">
          <view class="chip {{selectedCount === 0 ? 'on' : ''}}" bindtap="clearCats">全部</view>
          <view
            wx:for="{{categories}}"
            wx:key="value"
            class="chip {{selMap[item.value] ? 'on' : ''}}"
            bindtap="toggleCat"
            data-value="{{item.value}}"
          >{{item.label}}</view>
        </view>
      </scroll-view>
      <view class="chips-more" hover-class="btn-hover" bindtap="openFilter" aria-role="button" aria-label="展开全部分类">﹀</view>
    </view>

    <view class="filter-row">
      <view class="seg">
        <view
          wx:for="{{sides}}"
          wx:key="value"
          class="seg-item {{sideIndex === index ? 'on' : ''}}"
          bindtap="onSideTap"
          data-index="{{index}}"
        >{{item.label}}</view>
      </view>
      <picker range="{{sorts}}" range-key="label" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="sort-entry">{{sorts[sortIndex].label}}<text class="sort-caret">▾</text></view>
      </picker>
    </view>

    <view wx:if="{{!loggedIn}}" class="login-banner">
      <text class="login-banner-text">登录后可响应任务、接收消息</text>
      <view class="login-banner-btn" hover-class="btn-hover" bindtap="goLogin">去登录</view>
    </view>

    <!-- 已有数据时切换筛选/排序：顶部细条即时反馈，避免弱网下像点了没反应（spec 修复7） -->
    <view wx:if="{{loading && posts.length > 0}}" class="list-switching">
      <view class="switching-bar"></view>
      <text class="switching-text">加载中…</text>
    </view>

    <skeleton wx:if="{{loading && posts.length === 0}}" count="3" />

    <empty-state
      wx:elif="{{posts.length === 0}}"
      emoji="📭"
      title="还没有符合条件的任务"
      sub="换个筛选条件，或者发布第一条互助任务"
      btn-text="去发布"
      bind:action="goPublish"
    />

    <view
      wx:for="{{posts}}"
      wx:key="id"
      class="post-card"
      hover-class="card-hover"
      bindtap="openDetail"
      data-id="{{item.id}}"
    >
      <view class="post-top">
        <view class="side-tag {{item.sideClass}}">{{item.sideText}}</view>
        <view wx:if="{{item.hasPrice}}" class="price">
          <text class="price-yuan">¥</text>{{item.moneyText}}
          <text wx:if="{{item.priceHint}}" class="price-hint">{{item.priceHint}}</text>
        </view>
        <view wx:else class="price-alt">{{item.priceAlt}}</view>
      </view>
      <view class="post-mid">
        <view class="post-texts">
          <view class="post-title">{{item.title}}</view>
          <view class="post-desc">{{item.description}}</view>
        </view>
        <image wx:if="{{item.thumb}}" class="post-thumb" src="{{item.thumb}}" mode="aspectFill" />
      </view>
      <view class="post-foot">
        <image
          wx:if="{{item.avatarUrl}}"
          class="ava ava-img"
          src="{{item.avatarUrl}}"
          mode="aspectFill"
          binderror="onAvatarError"
          data-index="{{index}}"
        />
        <view wx:else class="ava" style="background: {{item.avatarColor}}">{{item.avatarChar}}</view>
        <text class="pub-name">{{item.publisherName}}</text>
        <text class="credit">★ {{item.creditText}}</text>
        <text wx:if="{{item.publishText}}" class="pub-time">· {{item.publishText}}</text>
        <view wx:if="{{item.deadlineText}}" class="due-pill">{{item.deadlineText}} 截止</view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="list-end">加载中…</view>
    <view wx:elif="{{hasMore}}" class="list-end">上拉加载更多</view>
    <view wx:elif="{{posts.length > 0}}" class="list-end">— 到底啦 —</view>
  </view>

  <view wx:if="{{sheetShow}}" class="sheet-mask" bindtap="closeFilter"></view>
  <view wx:if="{{sheetShow}}" class="filter-sheet">
    <view class="sheet-title">按分类筛选<text class="sheet-sub">可多选</text></view>
    <view class="sheet-tags">
      <view
        wx:for="{{categories}}"
        wx:key="value"
        class="sheet-tag {{tempMap[item.value] ? 'on' : ''}}"
        bindtap="toggleTempCat"
        data-value="{{item.value}}"
      >{{item.label}}</view>
    </view>
    <view class="sheet-actions">
      <view class="btn ghost sheet-btn" hover-class="btn-hover" bindtap="resetTemp">重置</view>
      <view class="btn sheet-btn" hover-class="btn-hover" bindtap="applyFilter">确定{{tempCount > 0 ? '（' + tempCount + '）' : ''}}</view>
    </view>
  </view>

  <!-- 首次启动新手引导：3 页说清 是什么 / 三种帖子 / 虚拟余额 -->
  <view wx:if="{{showOnboard}}" class="ob-mask">
    <view class="ob-card">
      <swiper class="ob-swiper" indicator-dots indicator-active-color="#5B8CFF" circular="{{false}}" bindchange="onObSwipe">
        <swiper-item>
          <view class="ob-slide">
            <view class="ob-emoji">🤝</view>
            <view class="ob-title">校园互助</view>
            <view class="ob-text">同学之间发任务、互相搭把手的小社区：取快递、辅导答疑、组队学习都可以。</view>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="ob-slide">
            <view class="ob-emoji">🏷️</view>
            <view class="ob-title">三种帖子</view>
            <view class="ob-text">悬赏：我出钱请人帮忙，接单完成可得赏金</view>
            <view class="ob-text">服务：TA 提供服务，下单需要付费</view>
            <view class="ob-text">互助：免费搭把手，不涉及钱</view>
          </view>
        </swiper-item>
        <swiper-item>
          <view class="ob-slide">
            <view class="ob-emoji">💰</view>
            <view class="ob-text-strong">余额是虚拟的，充值不花真钱</view>
            <view class="ob-text">交易金额会先由平台冻结托管，双方确认完成后才到账，安心交易。</view>
          </view>
        </swiper-item>
      </swiper>
      <button class="btn ob-btn" bindtap="closeOnboard">{{obIndex >= 2 ? '开始使用' : '我知道了'}}</button>
    </view>
  </view>
</view>
