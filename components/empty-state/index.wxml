<view class="es-wrap">
  <view wx:if="{{emoji}}" class="es-emoji">{{emoji}}</view>
  <view wx:if="{{title}}" class="es-title">{{title}}</view>
  <view wx:if="{{sub}}" class="es-sub">{{sub}}</view>
  <button wx:if="{{btnText}}" class="es-btn" hover-class="es-btn-hover" bindtap="onAction" aria-role="button" aria-label="{{btnText}}">{{btnText}}</button>
</view>
