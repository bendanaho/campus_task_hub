.gate {
  margin-top: 80rpx;
  text-align: center;
}

.gate-title {
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 14rpx;
}

.gate-btn {
  margin-top: 30rpx;
}

.field {
  margin-bottom: 26rpx;
}

.field:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-weight: 650;
}

.picker-box {
  min-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 10rpx;
  background: var(--field);
  display: flex;
  align-items: center;
  color: var(--ink);
}

.date-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.publish-btn {
  margin-top: 22rpx;
}

.warn-tip {
  margin-top: 12rpx;
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
}

.warn-link {
  color: var(--brand);
  font-weight: 600;
}

/* 标题/描述实时字数提示（spec 修复4） */
.counter {
  margin-top: 8rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--faint);
}

.counter.counter-warn {
  color: var(--amber);
  font-weight: 600;
}

/* 悬赏冻结担保的常驻预览（余额充足时显示） */
.freeze-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--muted);
}
