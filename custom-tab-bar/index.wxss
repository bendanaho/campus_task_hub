.tab-bar {
  --surface: #ffffff;
  --line: #E7ECF4;
  --faint: #98A2B5;
  --muted: #66718A;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-end;
  background: var(--surface);
  border-top: 1rpx solid var(--line);
  padding: 12rpx 8rpx;
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  z-index: 100;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
  position: relative;
}

.tab-badge {
  position: absolute;
  top: -8rpx;
  left: 50%;
  margin-left: 14rpx;
  min-width: 28rpx;
  height: 28rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #FA5151;
  color: #ffffff;
  font-size: 20rpx;
  line-height: 28rpx;
  text-align: center;
  box-sizing: border-box;
  z-index: 1;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}

.tab-text {
  font-size: 22rpx;
  /* --faint(#98A2B5)≈2.56:1 不达 WCAG AA，未选中文字提到 --muted(#66718A)≈4.7:1（修复5-a11y） */
  color: var(--muted);
  line-height: 1.2;
}

.tab-item.on .tab-text {
  color: #2E6BFF;
  font-weight: 600;
}

.publish-fab {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  margin-top: -52rpx;
  background: linear-gradient(160deg, #3D7BFF, #1746C7);
  box-shadow: 0 10rpx 24rpx rgba(46, 107, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.fab-on {
  box-shadow: 0 10rpx 28rpx rgba(23, 70, 199, 0.55);
}

.fab-plus {
  width: 40rpx;
  height: 40rpx;
  position: relative;
}

.fab-plus::before,
.fab-plus::after {
  content: '';
  position: absolute;
  background: var(--surface);
  border-radius: 4rpx;
}

.fab-plus::before {
  left: 50%;
  top: 0;
  bottom: 0;
  width: 5rpx;
  margin-left: -2.5rpx;
}

.fab-plus::after {
  top: 50%;
  left: 0;
  right: 0;
  height: 5rpx;
  margin-top: -2.5rpx;
}


.tab-bar.theme-dark {
  --surface: #1C2230;
  --line: #2A3346;
  --faint: #77839A;
  /* 深色下未选中文字用更亮的 muted，保证与 #1C2230 底对比达标 */
  --muted: #9AA5B8;
}


/* 选中态与发布加号跟随外观色系 */
.tab-bar.accent-b2 .tab-item.on .tab-text { color: #E39A45; }
.tab-bar.accent-b3 .tab-item.on .tab-text { color: #3EB27F; }
.tab-bar.accent-b4 .tab-item.on .tab-text { color: #4396F2; }
.tab-bar.accent-b5 .tab-item.on .tab-text { color: #EC7AA4; }
.tab-bar.accent-dark .tab-item.on .tab-text { color: #5B8CFF; }

.tab-bar.accent-b2 .publish-fab {
  background: linear-gradient(160deg, #EFB769, #CE7F2E);
  box-shadow: 0 10rpx 24rpx rgba(206, 127, 46, 0.4);
}

.tab-bar.accent-b3 .publish-fab {
  background: linear-gradient(160deg, #6FCBA0, #22946A);
  box-shadow: 0 10rpx 24rpx rgba(34, 148, 106, 0.4);
}

.tab-bar.accent-b4 .publish-fab {
  background: linear-gradient(160deg, #6FB6FF, #2E78D9);
  box-shadow: 0 10rpx 24rpx rgba(46, 120, 217, 0.4);
}

.tab-bar.accent-b5 .publish-fab {
  background: linear-gradient(160deg, #F49BBB, #D95C8C);
  box-shadow: 0 10rpx 24rpx rgba(217, 92, 140, 0.4);
}

.tab-bar.accent-dark .publish-fab {
  background: linear-gradient(160deg, #5B8CFF, #2E4E9E);
  box-shadow: 0 10rpx 24rpx rgba(0, 0, 0, 0.5);
}

/* 新增背景色 b6~b10 的选中文字色与发布 + 按钮渐变，随换肤一起变色 */
.tab-bar.accent-b6 .tab-item.on .tab-text { color: #7D5FD1; }
.tab-bar.accent-b7 .tab-item.on .tab-text { color: #0FA189; }
.tab-bar.accent-b8 .tab-item.on .tab-text { color: #E9752E; }
.tab-bar.accent-b9 .tab-item.on .tab-text { color: #566378; }
.tab-bar.accent-b10 .tab-item.on .tab-text { color: #C99A15; }

.tab-bar.accent-b6 .publish-fab {
  background: linear-gradient(160deg, #A78BE8, #5E43B0);
  box-shadow: 0 10rpx 24rpx rgba(94, 67, 176, 0.4);
}

.tab-bar.accent-b7 .publish-fab {
  background: linear-gradient(160deg, #43C7B0, #077E6B);
  box-shadow: 0 10rpx 24rpx rgba(7, 126, 107, 0.4);
}

.tab-bar.accent-b8 .publish-fab {
  background: linear-gradient(160deg, #F5A063, #C25A1B);
  box-shadow: 0 10rpx 24rpx rgba(194, 90, 27, 0.4);
}

.tab-bar.accent-b9 .publish-fab {
  background: linear-gradient(160deg, #7C8AA0, #3D485A);
  box-shadow: 0 10rpx 24rpx rgba(61, 72, 90, 0.4);
}

.tab-bar.accent-b10 .publish-fab {
  background: linear-gradient(160deg, #E4BC4A, #A17A0C);
  box-shadow: 0 10rpx 24rpx rgba(161, 122, 12, 0.4);
}
