.room {
  min-height: 100vh;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.chat-head {
  flex: none;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.order-line {
  color: var(--brand);
  font-size: 24rpx;
}

.head-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.mini-tag {
  background: var(--green-soft);
  color: var(--green);
  font-size: 20rpx;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.head-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.order-entry {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}

.review-btn {
  background: var(--brand);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
}

.messages {
  flex: 1;
  height: 0;
  min-height: 0;
  margin-bottom: 18rpx;
  overflow: hidden;
}

/* 加载骨架气泡 */
.sk-bubble {
  height: 72rpx;
  width: 44%;
  border-radius: 14rpx;
  background: var(--field);
  margin-bottom: 26rpx;
  animation: chat-sk-pulse 1.2s ease-in-out infinite;
}

.sk-bubble.wide {
  width: 62%;
}

.sk-bubble.side-mine {
  margin-left: auto;
}

@keyframes chat-sk-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.45; }
}

.msg {
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
}

.msg.mine {
  align-items: flex-end;
}

.msg.other {
  align-items: flex-start;
}

.msg.withdrawn-msg {
  align-items: center;
  margin-bottom: 20rpx;
}

.msg.system-msg {
  align-items: center;
  margin-bottom: 20rpx;
}

.system-tip {
  background: var(--field);
  color: var(--muted);
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: 999rpx;
  padding: 10rpx 26rpx;
  max-width: 86%;
  text-align: center;
}

/* 聊天字号（消息设置里可调） */
.messages.font-small .bubble {
  font-size: 24rpx;
}

.messages.font-large .bubble {
  font-size: 34rpx;
}

.msg-time {
  margin-bottom: 8rpx;
  color: var(--faint);
  font-size: 22rpx;
}

.withdrawn-tip {
  color: var(--faint);
  font-size: 23rpx;
  line-height: 1.4;
}

.bubble-row {
  max-width: 78%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bubble {
  min-width: 0;
  padding: 20rpx 22rpx;
  border-radius: 14rpx;
  line-height: 1.55;
}

.bubble.pending {
  opacity: 0.65;
}

.failed-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: var(--reward);
  color: var(--surface);
  font-size: 26rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.mine .bubble {
  background: var(--brand);
  color: #ffffff;
}

.other .bubble {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--ink);
}

.payment-title {
  font-weight: 800;
}

.payment-money {
  margin: 12rpx 0;
  font-size: 36rpx;
  font-weight: 850;
}

.payment-actions {
  margin-top: 16rpx;
  display: flex;
  gap: 12rpx;
}

.pay-title {
  margin-bottom: 14rpx;
  font-weight: 800;
}

.pay-box {
  flex: none;
  margin-bottom: 18rpx;
}

.pay-row {
  display: grid;
  grid-template-columns: 116rpx minmax(0, 1fr) 112rpx;
  gap: 12rpx;
  align-items: center;
}

.kind,
.pay-input {
  width: 100%;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 10rpx;
  background: var(--field);
  display: flex;
  align-items: center;
}

.pay-row .btn {
  width: 100%;
  min-width: 0;
  padding: 0;
}

.input-bar {
  flex: none;
  display: grid;
  grid-template-columns: 68rpx minmax(0, 1fr) 112rpx;
  gap: 12rpx;
  align-items: center;
}

.emoji-toggle {
  width: 68rpx;
  height: 68rpx;
  border-radius: 50%;
  background: var(--surface);
  border: 1rpx solid var(--line);
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.emoji-panel {
  flex: none;
  margin-top: 14rpx;
  background: var(--surface);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-card);
  padding: 16rpx;
  display: flex;
  flex-wrap: wrap;
}

.emoji-item {
  width: 12.5%;
  text-align: center;
  font-size: 44rpx;
  line-height: 1;
  padding: 14rpx 0;
}

.message-input {
  width: 100%;
  min-width: 0;
  height: 72rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: var(--surface);
  border: 1rpx solid var(--line);
}

.input-bar .btn {
  width: 100%;
  min-width: 0;
  padding: 0;
}

.quick-row {
  flex: none;
  margin-bottom: 14rpx;
  width: 100%;
}

.quick-inner {
  display: inline-flex;
  gap: 14rpx;
}

.quick-chip {
  flex: 0 0 auto;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 10rpx 24rpx;
}
