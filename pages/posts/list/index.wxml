<view class="hall">
  <view class="hall-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="hall-nav"></view>
    <view class="hall-title">校园互助</view>
    <view class="hall-subtitle">帮你找到愿意搭把手的同学</view>
    <view class="hall-search">
      <view class="search-icon"></view>
      <input
        class="search-input"
        placeholder="搜索任务、服务或同学"
        placeholder-class="search-placeholder"
        value="{{keyword}}"
        bindinput="onKeywordInput"
        confirm-type="search"
        bindconfirm="onSearch"
      />
      <view wx:if="{{keyword}}" class="search-go" catchtap="onSearch">搜索</view>
    </view>
  </view>

  <view class="hall-body">
    <scroll-view class="chips-scroll" scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}">
      <view class="chips">
        <view
          class="chip {{category === '' ? 'on' : ''}}"
          bindtap="onCategoryTap"
          data-value=""
        >全部</view>
        <view
          wx:for="{{categories}}"
          wx:key="value"
          class="chip {{category === item.value ? 'on' : ''}}"
          bindtap="onCategoryTap"
          data-value="{{item.value}}"
        >{{item.label}}</view>
      </view>
    </scroll-view>

    <view class="filter-row">
      <view class="seg">
        <view
          wx:for="{{sides}}"
          wx:key="value"
          class="seg-item {{sideIndex === index ? 'on' : ''}}"
          bindtap="onSideTap"
          data-index="{{index}}"
        >{{item.label}}</view>
      </view>
      <picker range="{{sorts}}" range-key="label" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="sort-entry">{{sorts[sortIndex].label}}<text class="sort-caret">▾</text></view>
      </picker>
    </view>

    <view wx:if="{{!loggedIn}}" class="login-banner">
      <text class="login-banner-text">登录后可响应任务、接收消息</text>
      <view class="login-banner-btn" hover-class="btn-hover" bindtap="goLogin">去登录</view>
    </view>

    <block wx:if="{{loading && posts.length === 0}}">
      <view wx:for="{{skeletons}}" wx:key="*this" class="skeleton">
        <view class="sk-row">
          <view class="sk-block sk-tag"></view>
          <view class="sk-block sk-price"></view>
        </view>
        <view class="sk-block sk-title"></view>
        <view class="sk-block sk-desc"></view>
        <view class="sk-block sk-meta"></view>
      </view>
    </block>

    <view wx:elif="{{posts.length === 0}}" class="empty-state">
      <view class="empty-emoji">📭</view>
      <view class="empty-title">还没有符合条件的任务</view>
      <view class="empty-sub">换个筛选条件，或者发布第一条互助任务</view>
      <view class="btn small empty-btn" hover-class="btn-hover" bindtap="goPublish">去发布</view>
    </view>

    <view
      wx:for="{{posts}}"
      wx:key="id"
      class="post-card"
      hover-class="card-hover"
      bindtap="openDetail"
      data-id="{{item.id}}"
    >
      <view class="post-top">
        <view class="side-tag {{item.sideClass}}">{{item.sideText}}</view>
        <view wx:if="{{item.hasPrice}}" class="price"><text class="price-yuan">¥</text>{{item.moneyText}}</view>
        <view wx:else class="price-alt">{{item.priceAlt}}</view>
      </view>
      <view class="post-mid">
        <view class="post-texts">
          <view class="post-title">{{item.title}}</view>
          <view class="post-desc">{{item.description}}</view>
        </view>
        <image wx:if="{{item.thumb}}" class="post-thumb" src="{{item.thumb}}" mode="aspectFill" />
      </view>
      <view class="post-foot">
        <view class="ava" style="background: {{item.avatarColor}}">{{item.avatarChar}}</view>
        <text class="pub-name">{{item.publisherName}}</text>
        <text class="credit">★ {{item.creditText}}</text>
        <text wx:if="{{item.publishText}}" class="pub-time">· {{item.publishText}}</text>
        <view wx:if="{{item.deadlineText}}" class="due-pill">{{item.deadlineText}} 截止</view>
      </view>
    </view>

    <view wx:if="{{posts.length > 0}}" class="list-end">— 到底啦 —</view>
  </view>
</view>
