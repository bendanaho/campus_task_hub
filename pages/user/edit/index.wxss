.field {
  margin-bottom: 24rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: var(--muted);
  font-weight: 650;
}

.current {
  margin-bottom: 12rpx;
  color: var(--muted);
  font-size: 24rpx;
}

.form-hint {
  margin-bottom: 20rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.verify-text {
  margin-top: 8rpx;
  color: var(--amber);
  font-weight: 700;
}

.verify-text.ok {
  color: var(--green);
}

.verify-link {
  color: var(--brand);
  font-size: 26rpx;
  font-weight: 600;
}

.avatar-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
}

.avatar-ops {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
}

.avatar-btn {
  min-height: 60rpx;
}

.avatar-reset {
  display: inline-flex;
  align-items: center;
  min-height: 88rpx;
  padding: 0 8rpx;
  font-size: 24rpx;
  color: var(--muted);
}

.swatch-label {
  margin-top: 28rpx;
}

.swatches {
  margin-top: 16rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.swatch {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid transparent;
  box-sizing: border-box;
}

.swatch.on {
  border-color: var(--ink);
  box-shadow: 0 0 0 4rpx var(--surface) inset;
}

.avatar-tip {
  margin-top: 24rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--muted);
}

.bio-input {
  width: 100%;
  min-height: 160rpx;
  margin-top: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  background: var(--field);
  border-radius: 14rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

.bio-foot {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bio-count {
  color: var(--muted);
  font-size: 24rpx;
}

.bio-save {
  min-height: 60rpx;
}

.photo-tip {
  margin-top: 10rpx;
  color: var(--muted);
  font-size: 24rpx;
  line-height: 1.5;
}

.photo-grid {
  margin-top: 18rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-cell {
  position: relative;
  width: 210rpx;
  height: 210rpx;
}

.photo-img {
  width: 100%;
  height: 100%;
  border-radius: 14rpx;
  background: var(--field);
}

.photo-del {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid var(--surface);
  background: rgba(23, 35, 61, 0.7);
  color: #ffffff;
  font-size: 28rpx;
  line-height: 34rpx;
  text-align: center;
}

.photo-add {
  width: 210rpx;
  height: 210rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 14rpx;
  border: 2rpx dashed var(--line);
  background: var(--field);
  color: var(--muted);
  font-size: 56rpx;
}

.pwd-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.pwd-eye {
  color: var(--brand);
  font-size: 24rpx;
  font-weight: 600;
}
