.guest {
  margin-top: 90rpx;
  text-align: center;
}

.guest-title {
  font-size: 34rpx;
  font-weight: 800;
}

.guest-btn {
  margin-top: 28rpx;
}

.tabs {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.tab {
  min-height: 66rpx;
  border-radius: 10rpx;
  background: #ffffff;
  border: 1rpx solid #e1e6ee;
  color: #667386;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tab.active {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
  font-weight: 700;
}

.amount {
  color: var(--reward);
  font-size: 34rpx;
  font-weight: 850;
}

.title {
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 800;
}

.meta {
  margin-top: 16rpx;
  color: #8a95a6;
  font-size: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.toolbar {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.search-box {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: var(--surface);
  border-radius: 999rpx;
  padding: 0 24rpx;
  height: 72rpx;
  box-shadow: var(--shadow-card);
}

.search-icon {
  width: 22rpx;
  height: 22rpx;
  border: 4rpx solid var(--faint);
  border-radius: 50%;
  position: relative;
  flex: 0 0 auto;
}

.search-icon::after {
  content: '';
  position: absolute;
  width: 4rpx;
  height: 12rpx;
  background: var(--faint);
  border-radius: 2rpx;
  left: 18rpx;
  top: 16rpx;
  transform: rotate(-45deg);
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  height: 72rpx;
  line-height: 72rpx;
}

.sort-entry {
  flex: 0 0 auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: var(--muted);
  background: var(--surface);
  border-radius: 999rpx;
  padding: 14rpx 22rpx;
  box-shadow: var(--shadow-card);
}

.sort-caret {
  font-size: 18rpx;
  color: var(--faint);
}

.waiting-tip {
  margin-top: 18rpx;
  background: var(--amber-soft);
  color: var(--amber);
  font-size: 23rpx;
  line-height: 1.5;
  border-radius: 12rpx;
  padding: 12rpx 18rpx;
}

.actions {
  margin-top: 22rpx;
  display: flex;
  flex-wrap: nowrap;
  align-items: center;
  gap: 14rpx;
}

/* 原生 button 默认撑满整行，这里压回弹性等分，横向一排 */
.actions .btn {
  flex: 1;
  min-width: 0;
  width: auto;
  padding-left: 0;
  padding-right: 0;
}

.order-del {
  flex: 0 0 auto;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--reward-soft);
  color: #E14D0B;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}
